{
  "name": "crotoshop",
  "private": true,
  "version": "2.0.0",
  "description": "Editor híbrido de imágenes y vectores con IA local",
  "author": "Gabriel Hufschmid",
  "license": "UNLICENSED",
  "homepage": "https://github.com/GabrielHufschmid/crotoshop#desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/GabrielHufschmid/crotoshop.git",
    "directory": "MacOs-crotoshop"
  },
  "bugs": {
    "url": "https://github.com/GabrielHufschmid/crotoshop/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "dist:mac": "npm run build && npm run build:backend && electron-builder --mac dir",
    "dist:mac:local": "node scripts/build-local-macos.mjs",
    "dist:dmg": "npm run build && npm run build:backend && electron-builder --mac dmg",
    "release:mac": "node scripts/verify-apple-release.mjs && npm run build && npm run build:backend && electron-builder --mac dmg zip",
    "verify:mac": "node scripts/verify-macos-artifact.mjs",
    "dist:win": "npm run build && npm run build:backend && electron-builder --win nsis",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@okathira/ghostpdl-wasm": "^1.1.0",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "ar.com.gabi.crotoshop",
    "productName": "Crotoshop",
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "artifactName": "Crotoshop-${version}-${arch}.${ext}",
    "electronLanguages": [
      "es",
      "en"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend"
      },
      {
        "from": "backend-models",
        "to": "backend-models"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/Crotoshop.icns",
      "target": [
        "dir"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "crotoshop",
        "name": "Proyecto Crotoshop",
        "role": "Editor"
      }
    ]
  }
}
